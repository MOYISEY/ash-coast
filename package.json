{
  "name": "ash-coast",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "build": "vite build && node tools/freeze-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5193 --strictPort",
    "test": "node --test tests/*.test.js tests/*.test.mjs qa/tests/*.test.mjs",
    "test:integration": "node qa/run-rules.mjs",
    "test:release": "node qa/release-copy.browser.mjs",
    "test:saves": "node qa/save-browser.mjs",
    "test:ui": "node qa/run-ui.mjs",
    "test:regressions": "node qa/run-regressions.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "playwright-core": "^1.56.0"
  }
}
